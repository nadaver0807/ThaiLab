# --- Server ---
# Railway/Render inject PORT automatically; leave unset in production.
PORT=3000
NODE_ENV=production

# Public URL of the deployed client — used for CORS. No trailing slash.
CLIENT_ORIGIN=https://thailab.co.il

# Public URL of this API — used to build order-approval links sent by email
# and the payment return URLs. No trailing slash.
SERVER_PUBLIC_URL=https://api.thailab.co.il

# --- Database ---
# Managed providers give a single connection string; prefer it when available.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required for managed Postgres (Neon / Railway / Supabase / Render).
DB_SSL=true
DB_SCHEMA=thailab

# --- Admin session ---
# REQUIRED in production. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

# --- Admin users ---
# Format: email:password,email:password (min 10 chars). Used by `npm run seed`.
SEED_ADMIN_USERS=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="ThaiLab <orders@your-verified-domain.com>"
ADMIN_EMAIL=owner@example.com

# --- Credit card clearing (Grow via Make.com) ---
# Leave PAYMENT_PROVIDER unset (or NONE) to hide the credit-card option in
# checkout — the site then works with pay-on-collection only.
PAYMENT_PROVIDER=MAKE
# The Make scenario's webhook URL. Receives { orderId, amount, customer, items,
# successUrl, cancelUrl, callbackUrl } and must respond with { paymentUrl }.
MAKE_PAYMENT_WEBHOOK_URL=
# REQUIRED. Make must send it in the `x-make-webhook-secret` header when POSTing
# { orderId, status: "PAID" | "FAILED", transactionId } to callbackUrl
# (or to /api/checkout/payment-webhook). Generate with: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=
MAKE_PAYMENT_WEBHOOK_TIMEOUT_MS=10000
