# --- Server ---
# Railway/Render inject PORT automatically; leave unset in production.
PORT=3000
NODE_ENV=production

# Public URL of the deployed client — used for CORS. No trailing slash.
CLIENT_ORIGIN=https://thailab.co.il

# Public URL of this API — used to build order-approval links sent by email
# and the payment return URLs. No trailing slash.
SERVER_PUBLIC_URL=https://api.thailab.co.il

# --- Database ---
# Managed providers give a single connection string; prefer it when available.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required for managed Postgres (Neon / Railway / Supabase / Render).
DB_SSL=true
DB_SCHEMA=thailab

# --- Admin session ---
# REQUIRED in production. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

# --- Admin users ---
# Format: email:password,email:password (min 10 chars). Used by `npm run seed`.
SEED_ADMIN_USERS=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="ThaiLab <onboarding@resend.dev>"
ADMIN_EMAIL=hello@thailab.co.il

# --- Credit card clearing ---
# Leave PAYMENT_PROVIDER unset (or NONE) to hide the credit-card option in
# checkout — the site then works with pay-on-collection only.
# Supported: CARDCOM | PAYPLUS
PAYMENT_PROVIDER=NONE
# CardCom: Terminal Number. PayPlus: Payment Page UID.
PAYMENT_TERMINAL_ID=
# CardCom: ApiName. PayPlus: api_key.
PAYMENT_API_KEY=
# CardCom: ApiPassword. PayPlus: secret_key.
PAYMENT_API_SECRET=
# Use the provider's sandbox until the flow is verified end to end.
PAYMENT_TEST_MODE=true

# Webhook to register in the provider's dashboard:
#   https://api.thailab.co.il/api/payments/:uuid/callback
