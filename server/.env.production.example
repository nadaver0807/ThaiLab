# --- Server ---
# Railway/Render inject PORT automatically; leave unset in production.
PORT=3000
NODE_ENV=production

# Public URL of the deployed client — used for CORS. No trailing slash.
CLIENT_ORIGIN=https://your-app.vercel.app

# --- Database ---
# Managed providers give a single connection string; prefer it when available.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required for managed Postgres (Neon / Railway / Supabase / Render).
DB_SSL=true
DB_SCHEMA=thailab

# --- Admin session ---
# REQUIRED in production. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

# --- Admin users ---
# Format: email:password,email:password (min 10 chars). Used by `npm run seed`.
SEED_ADMIN_USERS=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="ThaiLab <onboarding@resend.dev>"
ADMIN_EMAIL=hello@thailab.co.il
