PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Public URL of this API — used for order-approval email links and payment
# return URLs. Locally the default (http://localhost:PORT) is fine.
SERVER_PUBLIC_URL=http://localhost:3000

# --- Email (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain/sender in Resend.
# For local testing you can use: ThaiLab <onboarding@resend.dev>
EMAIL_FROM="ThaiLab <onboarding@resend.dev>"
# Inbox that receives contact messages (and, later, orders)
ADMIN_EMAIL=hello@thailab.co.il

# Comma-separated admin credentials seeded into the admin_user table.
# Format: email:password,email:password
# Passwords must be at least 10 characters and are hashed before storage.
# Re-running the seed updates the password of an existing admin (password reset).
SEED_ADMIN_USERS=ofer@thailab.co.il:09870987,nad@pleasantlight.com:TL!n8364083

# --- Admin session ---
# Secret used to sign admin session tokens. REQUIRED in production.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# How long an admin stays signed in, in hours.
ADMIN_SESSION_TTL_HOURS=12

# --- Credit card clearing ---
# Leave unset (or NONE) to hide the credit-card option in checkout.
# Supported: CARDCOM | PAYPLUS
PAYMENT_PROVIDER=NONE
# CardCom: Terminal Number. PayPlus: Payment Page UID.
PAYMENT_TERMINAL_ID=
# CardCom: ApiName. PayPlus: api_key.
PAYMENT_API_KEY=
# CardCom: ApiPassword. PayPlus: secret_key.
PAYMENT_API_SECRET=
# Always true locally — never point a dev machine at a live terminal.
PAYMENT_TEST_MODE=true
