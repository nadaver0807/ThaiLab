{
  "name": "@thailab/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src ../shared",
    "typeorm": "tsx ../node_modules/typeorm/cli.js -d src/config/db/db.config.ts",
    "migration:create": "tsx ../node_modules/typeorm/cli.js migration:create ./migrations/migration",
    "migration:generate": "tsx ../node_modules/typeorm/cli.js migration:generate -d src/config/db/migrations.config.ts ./migrations/generated",
    "migration:revert": "tsx ../node_modules/typeorm/cli.js migration:revert -d src/config/db/migrations.config.ts",
    "migration:run": "tsx ../node_modules/typeorm/cli.js migration:run -d src/config/db/migrations.config.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.20",
    "@types/pg": "^8.21.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
