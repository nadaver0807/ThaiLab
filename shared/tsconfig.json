{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "./*"
      ],
      "zod": [
        "../server/node_modules/zod"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}
